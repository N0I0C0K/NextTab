{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": false,
    "noUncheckedIndexedAccess": false,
    "types": ["chrome", "node"]
  }
}
