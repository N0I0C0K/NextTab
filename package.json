{
  "name": "nexttab",
  "version": "1.4.1",
  "description": "Simple and modern start interface",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/N0I0C0K/NextTab"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "type-check": "wxt prepare && tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier . --write --cache --cache-location node_modules/.cache/.prettiercache",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build --mode test && playwright test",
    "test:e2e:ui": "wxt build --mode test && playwright test --ui",
    "check": "pnpm type-check && pnpm lint && pnpm test && pnpm build && pnpm build:firefox",
    "postinstall": "wxt prepare",
    "update-version": "bash update_version.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/helpers": "^0.1.21",
    "@dnd-kit/react": "^0.1.21",
    "@hookform/resolvers": "^5.2.2",
    "class-variance-authority": "^0.7.0",
    "cmdk": "1.0.0",
    "cn": "0.4.0",
    "deepmerge": "^4.3.1",
    "embla-carousel-react": "^8.5.1",
    "events": "^3.3.0",
    "expr-eval": "2.0.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.455.0",
    "moment": "^2.30.1",
    "mqtt": "^5.14.1",
    "nanoid": "^5.0.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.55.0",
    "react-hotkeys-hook": "^5.2.1",
    "react-icons": "^5.3.0",
    "shadcn": "4.21.0",
    "sonner": "^2.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "^0.0.270",
    "@types/lodash": "^4.17.13",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "fake-indexeddb": "^6.0.1",
    "lint-staged": "^15.2.7",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-classnames": "^0.8.2",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "web-ext": "^10.5.0",
    "wxt": "0.21.3"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "5.1.4"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
