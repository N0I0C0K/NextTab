{
  "name": "nexttab",
  "version": "1.4.1",
  "description": "Simple and modern start interface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/N0I0C0K/NextTab"
  },
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "e2e": "pnpm build && wdio run ./tests/e2e/config/wdio.browser.conf.ts",
    "e2e:firefox": "pnpm zip:firefox && cross-env __FIREFOX__=true wdio run ./tests/e2e/config/wdio.browser.conf.ts",
    "type-check": "wxt prepare && tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier . --write --cache --cache-location node_modules/.cache/.prettiercache",
    "update-version": "bash update_version.sh"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.1.21",
    "@dnd-kit/react": "^0.1.21",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-portal": "^1.1.9",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stitches/react": "^1.2.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "embla-carousel-react": "^8.5.1",
    "events": "^3.3.0",
    "expr-eval": "2.0.2",
    "framer-motion": "^11.14.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.455.0",
    "moment": "^2.30.1",
    "mqtt": "^5.14.1",
    "nanoid": "^5.0.8",
    "next-themes": "^0.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "^1.5.0",
    "react-hook-form": "^7.55.0",
    "react-hotkeys-hook": "^5.2.1",
    "react-icons": "^5.3.0",
    "react-resizable": "^3.0.5",
    "sonner": "^2.0.1",
    "tailwind-merge": "^2.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/lodash": "^4.17.13",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-resizable": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@wxt-dev/module-react": "1.2.2",
    "@wdio/cli": "^9.1.2",
    "@wdio/globals": "^9.1.2",
    "@wdio/local-runner": "^9.1.2",
    "@wdio/mocha-framework": "^9.2.8",
    "@wdio/spec-reporter": "^9.2.8",
    "@wdio/types": "^9.1.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "lint-staged": "^15.2.7",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-classnames": "^0.8.2",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.11",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.5.4",
    "wxt": "0.20.27"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
